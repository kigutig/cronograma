# ============================================================
# CRONOGRAMA DE ENTREGAS — EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local (nunca envie .env com valores reais ao Git)
# ============================================================

# Ambiente da aplicação (development | staging | production)
APP_ENV=development

# Credenciais públicas do Supabase (utilizadas com Row Level Security)
SUPABASE_URL=https://exemplo-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo_chave_publica_anonima

# Chave da Groq API para o assistente de voz Jarvis
# (ATENÇÃO: Em produção/homologação, deve ser cadastrada APENAS no Supabase:
# supabase secrets set GROQ_API_KEY=gsk_... --project-ref <seu-projeto>)
GROQ_API_KEY=gsk_exemplo_chave_groq_aqui

# Porta para servidor de desenvolvimento local
PORT=3000

